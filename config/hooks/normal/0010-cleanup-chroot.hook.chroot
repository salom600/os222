#!/bin/sh
# 0010-cleanup-chroot.hook.chroot
# Final cleanup before the chroot is squashed.
set -e

echo "[0010] Cleaning up chroot..."

# Clean apt cache to save space
apt-get clean
rm -rf /var/cache/apt/archives/*.deb
rm -rf /var/lib/apt/lists/*

# Clean pip cache
rm -rf /root/.cache/pip /home/*/.cache/pip 2>/dev/null || true

# Clean docs
rm -rf /usr/share/doc/* 2>/dev/null || true
rm -rf /usr/share/man/* 2>/dev/null || true

# Clean logs
find /var/log -type f -name "*.log" -exec truncate -s 0 {} \;
rm -rf /var/log/journal/* 2>/dev/null || true

# Remove temporary files
rm -rf /tmp/* /var/tmp/* 2>/dev/null || true

# Remove bash history
rm -f /root/.bash_history /home/*/.bash_history 2>/dev/null || true

# Pre-link
prelink --all 2>/dev/null || true

# ldconfig
ldconfig

# Save space — but keep enough for the Store to work
echo "salomos" > /etc/machine-id
echo "salomos-live" > /var/lib/salomos/build-id

echo "[0010] Chroot cleanup complete."
